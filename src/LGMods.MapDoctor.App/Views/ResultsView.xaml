<UserControl x:Class="LGMods.MapDoctor.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LGMods.MapDoctor.App.ViewModels">
    <UserControl.Resources>

        <!-- List rows -->
        <DataTemplate x:Key="MapRow" DataType="{x:Type vm:MapViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextBrush}" ToolTip="{Binding Name}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Style="{StaticResource Small}" Text="{Binding CategoryText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource Small}" Text="  ·  LGMods" Foreground="{StaticResource TealBrush}"
                                   Visibility="{Binding IsLgMods, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="{Binding CountTip}">
                    <Border Style="{StaticResource CountPill}" Background="{StaticResource ProblemSoftBrush}"
                            Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ProblemCount}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource ProblemBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Style="{StaticResource CountPill}" Background="{StaticResource WarningSoftBrush}"
                            Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding WarningCount}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE73E;" Foreground="{StaticResource TealBrush}" Opacity="0.8"
                               Visibility="{Binding IsClear, Converter={StaticResource BoolToVisibility}}" />                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FindingRow" DataType="{x:Type vm:FindingViewModel}">
            <Grid Opacity="{Binding RowOpacity}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" Fill="{Binding DotBrush}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,7,0,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding RowTitle}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="{Binding RowSubtitle}" Style="{StaticResource Small}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GroupHeader">
            <TextBlock Style="{StaticResource SectionLabel}" FontSize="12" Margin="14,14,0,6">
                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding ItemCount, Mode=OneWay}" FontWeight="Normal" />
            </TextBlock>
        </DataTemplate>

        <!-- Pieces used in the detail -->
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="ChipTemplate" DataType="{x:Type vm:MapChip}">
            <Button x:Name="B" Style="{StaticResource Chip}" Command="{Binding Command}" ToolTip="{Binding Tip}" Margin="0,0,6,6">
                <TextBlock x:Name="T" Text="{Binding Text}" />
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                    <Setter TargetName="B" Property="Background" Value="{StaticResource TealSoftBrush}" />
                    <Setter TargetName="B" Property="Foreground" Value="{StaticResource TealBrush}" />
                    <Setter TargetName="B" Property="Cursor" Value="Arrow" />
                    <Setter TargetName="T" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="FileLine" DataType="{x:Type vm:FindingViewModel+FileRow}">
            <TextBlock TextWrapping="Wrap" Margin="0,3,0,3" LineHeight="19">
                <Run Text="{Binding FileName, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{StaticResource TextBrush}" />
                <Run Text="   " />
                <Run Text="{Binding Meaning, Mode=OneWay}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
            </TextBlock>
        </DataTemplate>

        <!-- One clash as it affects the map being looked at -->
        <DataTemplate x:Key="IssueCardTemplate" DataType="{x:Type vm:IssueCard}">
            <Border Style="{StaticResource Card}" Padding="20,16,12,10" Margin="0,0,0,12" Opacity="{Binding Finding.RowOpacity}">
                <StackPanel>
                    <Grid Margin="0,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="7" Height="7" Fill="{Binding Finding.DotBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource H2}" Text="{Binding Title}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Small}" FontWeight="SemiBold" Foreground="{Binding Finding.SeverityBrush}"
                                   Text="{Binding Finding.SeverityLabel}" Margin="12,2,0,0" />
                    </Grid>

                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Body}" Margin="16,6,8,0"
                               Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Who wins, who loses, which files -->
                    <Grid Margin="16,14,8,0" Visibility="{Binding IsClash, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource Small}" FontWeight="SemiBold" Foreground="{StaticResource TealBrush}" Text="In use" Margin="0,4,0,0"
                                   ToolTip="Starts later, so its versions of the files are the ones players get" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Used}" ItemsPanel="{StaticResource Wrap}" ItemTemplate="{StaticResource ChipTemplate}" />

                        <TextBlock Grid.Row="1" Style="{StaticResource Small}" FontWeight="SemiBold" Foreground="{StaticResource ProblemBrush}" Text="Ignored" Margin="0,4,0,0"
                                   ToolTip="Starts earlier, so its versions of the files are replaced" />
                        <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Ignored}" ItemsPanel="{StaticResource Wrap}" ItemTemplate="{StaticResource ChipTemplate}" />

                        <TextBlock Grid.Row="2" Style="{StaticResource Small}" FontWeight="SemiBold" Foreground="{StaticResource Muted2Brush}" Text="Files" Margin="0,4,0,0" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,2">
                            <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource FileLine}" />
                            <Button Style="{StaticResource LinkButton}" Command="{Binding OpenCommand}" HorizontalAlignment="Left"
                                    Content="{Binding MoreFiles}" Visibility="{Binding HasMoreFiles, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Actions -->
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="16,12,0,0" Padding="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="-8,0,0,0">
                                <Button Style="{StaticResource QuietButton}" Command="{Binding ResolveCommand}" Foreground="{StaticResource TealBrush}"
                                        ToolTip="Choose whose version of each file to use"
                                        Visibility="{Binding IsClash, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE90F;" Margin="0,0,7,0" />
                                        <TextBlock Text="Resolve" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuietButton}" Command="{Binding Finding.CopyMessageCommand}"
                                        ToolTip="Copies a ready-made message you can send to the map makers"
                                        Visibility="{Binding IsClash, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE8C8;" Margin="0,0,7,0" />
                                        <TextBlock Text="Message map makers" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuietButton}" Command="{Binding Finding.ToggleFineCommand}" ToolTip="{Binding Finding.FineHint}"
                                        Visibility="{Binding Finding.CanMarkFine, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="{Binding Finding.FineIcon}" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding Finding.FineLabel}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Style="{StaticResource Small}" Foreground="{StaticResource TealBrush}" Text="{Binding Finding.Feedback}"
                                       VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Style="{StaticResource QuietButton}" Command="{Binding OpenCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding OpenLabel}" />
                                    <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE76C;" Margin="7,1,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Detail: a map -->
        <DataTemplate DataType="{x:Type vm:MapViewModel}">
            <StackPanel Margin="32,28,28,28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource H1}" FontSize="24" Text="{Binding Name}" />
                        <WrapPanel Margin="0,6,0,0">
                            <Border Style="{StaticResource Tag}" Background="{StaticResource TealSoftBrush}" Margin="0,0,8,0"
                                    Visibility="{Binding IsLgMods, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource TagText}" Foreground="{StaticResource TealBrush}" Text="LGMods" />
                            </Border>
                            <Border Style="{StaticResource Tag}" Background="{StaticResource Surface3Brush}" Margin="0,0,8,0"
                                    Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Protected with FiveM Escrow, so only its maker can change its files">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE72E;" Foreground="{StaticResource MutedBrush}" Margin="0,0,5,0" />
                                    <TextBlock Style="{StaticResource TagText}" Foreground="{StaticResource MutedBrush}" Text="Locked" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Small}" Text="{Binding Meta}" VerticalAlignment="Center" ToolTip="{Binding FolderPath}" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                        <Button Style="{StaticResource SmallGhostButton}" Command="{Binding OpenFolderCommand}" ToolTip="{Binding FolderPath}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE838;" Margin="0,0,8,0" />
                                <TextBlock Text="Open folder" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ResolveCommand}" Margin="8,0,0,0" Padding="14,6" FontSize="12.5"
                                ToolTip="Choose whose version of each clashing file to use"
                                Visibility="{Binding CanResolve, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE90F;" Margin="0,0,8,0" Foreground="{StaticResource TealInkBrush}" />
                                <TextBlock Text="Resolve clashes" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Verdict -->
                <Border Background="{Binding VerdictSoft}" BorderBrush="{Binding VerdictEdge}" BorderThickness="1" CornerRadius="10" Padding="16,14,18,14" Margin="0,22,0,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="{Binding VerdictIcon}" Foreground="{Binding VerdictBrush}"
                                   VerticalAlignment="Top" Margin="0,1,14,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource H2}" Text="{Binding VerdictTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding VerdictText}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource IssueCardTemplate}" Focusable="False" />
            </StackPanel>
        </DataTemplate>

        <!-- Detail: a clash or other finding -->
        <DataTemplate DataType="{x:Type vm:FindingViewModel}">
            <StackPanel Margin="32,28,28,28">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{Binding SeverityBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Small}" FontWeight="SemiBold" Foreground="{Binding SeverityBrush}" Text="{Binding SeverityLabel}" />
                </StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="{Binding Title}" Margin="0,8,0,8" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding Intro}" />

                <!-- Maps involved -->
                <StackPanel Visibility="{Binding HasMaps, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SectionLabel}" Margin="0,26,0,8">
                        <Run Text="{Binding MapsLabel, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Maps.Count, Mode=OneWay}" FontWeight="Normal" />
                    </TextBlock>
                    <Border Style="{StaticResource Card}">
                        <ItemsControl ItemsSource="{Binding Maps}" Focusable="False" Margin="5">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Command="{Binding ViewMapCommand}" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="See everything this map clashes with">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,10,8,10" Margin="0,1">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3Brush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Style="{StaticResource Small}" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,10,0"
                                                                ToolTip="{Binding StatusHint}" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                                                        <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" Text="{Binding Status}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Style="{StaticResource Icon}" FontSize="10" Text="&#xE76C;" Foreground="{StaticResource Muted2Brush}" />
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding OpenFolderCommand}" ToolTip="Open its folder"
                                                    Margin="2,0,8,0">
                                                <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE838;" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                            <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- Clashing files -->
                <StackPanel Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SectionLabel}" Margin="0,24,0,8">
                        <Run Text="Clashing files" /><Run Text="   " /><Run Text="{Binding Files.Count, Mode=OneWay}" FontWeight="Normal" />
                    </TextBlock>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="16,9,16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*" />
                                    <ColumnDefinition Width="5*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Small}" Foreground="{StaticResource Muted2Brush}" Text="File" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Small}" Foreground="{StaticResource Muted2Brush}" Text="What it controls in game" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Files}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5*" />
                                                    <ColumnDefinition Width="5*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Mono}" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FileName}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource Small}" Text="{Binding Meaning}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- What to do -->
                <TextBlock Style="{StaticResource SectionLabel}" Text="What to do" Margin="0,24,0,10" />
                <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number}" Foreground="{StaticResource TealBrush}" FontWeight="SemiBold" FontSize="13.5" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Body}" Text="{Binding Text}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Actions -->
                <WrapPanel Margin="0,14,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ResolveCommand}" Margin="0,0,8,8"
                            ToolTip="Choose whose version of each file to use"
                            Visibility="{Binding IsClash, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE90F;" Margin="0,0,8,0" Foreground="{StaticResource TealInkBrush}" />
                            <TextBlock Text="Resolve" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding CopyMessageCommand}" Margin="0,0,8,8"
                            Visibility="{Binding IsClash, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE8C8;" Margin="0,0,8,0" />
                            <TextBlock Text="Copy message for map makers" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ToggleFineCommand}" Margin="0,0,8,8" ToolTip="{Binding FineHint}"
                            Visibility="{Binding CanMarkFine, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="{Binding FineIcon}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding FineLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding CopySupportCommand}" Margin="0,0,8,8"
                            ToolTip="Copies the details so you can paste them in a support ticket" Content="Copy for support" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Small}" Foreground="{StaticResource TealBrush}" Text="{Binding Feedback}" />

                <!-- Technical -->
                <ToggleButton Style="{StaticResource LinkButton}" IsChecked="{Binding ShowLocations}" HorizontalAlignment="Left" Margin="0,12,0,0"
                              Visibility="{Binding HasLocations, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LocationsLabel}" />
                        <TextBlock Style="{StaticResource Icon}" FontSize="10" Margin="6,2,0,0">
                            <TextBlock.Text>
                                <Binding Path="ShowLocations">
                                    <Binding.Converter>
                                        <vm:ChevronConverter />
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </ToggleButton>
                <TextBox Style="{StaticResource DetailsBox}" Text="{Binding LocationsText, Mode=OneWay}" Margin="0,8,0,0"
                         Visibility="{Binding ShowLocations, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Headline -->
        <Grid Margin="32,26,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap">
                    <Run Text="{Binding HeadlineNumber, Mode=OneWay}" Foreground="{Binding HeadlineBrush, Mode=OneWay}" /><Run Text="{Binding HeadlineRest, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Muted}" Text="{Binding Subline}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button Style="{StaticResource GhostButton}" Command="{Binding OpenPastFixesCommand}" Margin="0,0,8,0" ToolTip="{Binding PastFixesTip}"
                        Visibility="{Binding HasPastFixes, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE7A7;" Margin="0,0,8,0" />
                        <TextBlock Text="Undo fixes" />
                        <TextBlock Text="{Binding PastFixes.Count}" Foreground="{StaticResource Muted2Brush}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Command="{Binding ScanAgainCommand}" Margin="0,0,8,0" ToolTip="Check the same server again">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE72C;" Margin="0,0,8,0" />
                        <TextBlock Text="Scan again" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Command="{Binding SaveReportCommand}"
                        ToolTip="Saves a web page you can send to map makers or support">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE72D;" Margin="0,0,8,0" />
                        <TextBlock Text="Save report" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- After a fix or an undo -->
        <Border Grid.Row="1" Margin="32,18,32,0" Background="{StaticResource TealTintBrush}" BorderBrush="{StaticResource TealEdgeBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,12,10,12" DataContext="{Binding Notice}"
                Visibility="{Binding DataContext.HasNotice, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xE73E;" Foreground="{StaticResource TealBrush}" VerticalAlignment="Top" Margin="0,2,14,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource H2}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Text}" Margin="0,2,0,0" />
                    <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource ProblemBrush}" Text="{Binding Error}" Margin="0,6,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Style="{StaticResource SmallGhostButton}" Command="{Binding OpenBackupCommand}" Margin="0,0,8,0"
                            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}" Content="Open backup folder" />
                    <Button Style="{StaticResource SmallGhostButton}" Command="{Binding UndoCommand}"
                            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE7A7;" Margin="0,0,8,0" />
                            <TextBlock Text="Undo" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Margin="6,0,0,0" ToolTip="Hide this"
                            Command="{Binding DataContext.DismissNoticeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="11" Text="&#xE711;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search, filter, view -->
        <Grid Grid.Row="2" Margin="32,22,32,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" MaxWidth="420" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Height="36" MinWidth="200" Tag="{Binding SearchHint}"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <Border Grid.Column="2" Style="{StaticResource SegmentGroup}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="filter" IsChecked="{Binding ShowProblems}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource ProblemBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ProblemsLabel}" />
                            <TextBlock Text="{Binding ProblemsCount}" Foreground="{StaticResource Muted2Brush}" Margin="7,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Segment}" GroupName="filter" IsChecked="{Binding ShowWarnings}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Worth checking" />
                            <TextBlock Text="{Binding WarningsCount}" Foreground="{StaticResource Muted2Brush}" Margin="7,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Segment}" GroupName="filter" IsChecked="{Binding ShowAll}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding AllLabel}" />
                            <TextBlock Text="{Binding AllCount}" Foreground="{StaticResource Muted2Brush}" Margin="7,0,0,0" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource SegmentGroup}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="view" IsChecked="{Binding IsMapView}" ToolTip="Pick a map to see what it clashes with">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE707;" Margin="0,0,7,0" />
                            <TextBlock Text="By map" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Segment}" GroupName="view" IsChecked="{Binding IsClashView}" ToolTip="Every clash on its own">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE8AB;" Margin="0,0,7,0" />
                            <TextBlock Text="By clash" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
        </Grid>

        <!-- List + detail, in one panel -->
        <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="32,0,32,28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.4*" MinWidth="280" MaxWidth="380" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <ListBox x:Name="FindingList" Style="{StaticResource PlainList}" ItemsSource="{Binding FindingsView}" SelectedItem="{Binding Selected}"
                             ItemTemplate="{StaticResource FindingRow}" IsSynchronizedWithCurrentItem="False" SelectionChanged="OnListSelectionChanged"
                             Visibility="{Binding IsClashView, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource GroupHeader}" />
                        </ListBox.GroupStyle>
                    </ListBox>
                    <ListBox x:Name="MapList" Style="{StaticResource PlainList}" ItemsSource="{Binding MapsView}" SelectedItem="{Binding SelectedMap}"
                             ItemTemplate="{StaticResource MapRow}" IsSynchronizedWithCurrentItem="False" SelectionChanged="OnListSelectionChanged"
                             Visibility="{Binding IsMapView, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource GroupHeader}" />
                        </ListBox.GroupStyle>
                    </ListBox>
                    <StackPanel Margin="22,24,22,0" Visibility="{Binding ListIsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding EmptyListText}" />
                        <Button Style="{StaticResource LinkButton}" FontSize="13" Command="{Binding ShowEverythingCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                Visibility="{Binding CanShowEverything, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ShowEverythingLabel}" />
                                <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE76C;" Margin="6,1,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Rectangle Grid.Column="1" Fill="{StaticResource LineBrush}" />

                <ScrollViewer x:Name="DetailScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ContentControl Content="{Binding Detail}" Focusable="False" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
