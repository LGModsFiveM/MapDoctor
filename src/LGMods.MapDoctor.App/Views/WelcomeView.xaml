<UserControl x:Class="LGMods.MapDoctor.App.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,48,40,32" MaxWidth="640" HorizontalAlignment="Center">
            <TextBlock Style="{StaticResource Eyebrow}" Text="FREE FROM LGMODS" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource Display}" FontSize="68" LineHeight="64" Margin="0,8,0,0" TextAlignment="Center">
                <Run Text="FIND MAP CLASHES." /><LineBreak />
                <Run Text="SORTED." Foreground="{StaticResource TealBrush}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Muted}" FontSize="15" LineHeight="23" Margin="0,16,0,0" MaxWidth="520" TextAlignment="Center"
                       Text="See which maps on your FiveM server are fighting over the same files, what players will notice, and what to do about it." />

            <!-- Drop zone -->
            <Grid Margin="0,36,0,0">
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" />
                <Rectangle x:Name="DropOutline" RadiusX="14" RadiusY="14" StrokeThickness="1.5" StrokeDashArray="5 4"
                           Stroke="{StaticResource LineStrongBrush}" />
                <StackPanel HorizontalAlignment="Center" Margin="24,34,24,32">
                    <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource TealSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" FontSize="20" Text="&#xE8B7;" Foreground="{StaticResource TealBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Style="{StaticResource H2}" FontSize="17" Text="Drop your server folder here" HorizontalAlignment="Center" Margin="0,16,0,4" />
                    <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center">
                        <Run Text="The one with" /> <Run Text="server.cfg" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextBrush}" /> <Run Text="in it. Your resources folder works too." />
                    </TextBlock>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding PickFolderCommand}" HorizontalAlignment="Center"
                            Margin="0,20,0,0" Padding="20,10">
                        <TextBlock Text="Choose folder" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Reassurance -->
            <WrapPanel Margin="0,16,0,0" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="10,0,10,6">
                    <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE73E;" Foreground="{StaticResource TealBrush}" Margin="0,0,7,0" />
                    <TextBlock Style="{StaticResource Small}" Text="Only changes files when you choose to" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="10,0,10,6">
                    <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE73E;" Foreground="{StaticResource TealBrush}" Margin="0,0,7,0" />
                    <TextBlock Style="{StaticResource Small}" Text="No login, nothing uploaded" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="10,0,10,6">
                    <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE73E;" Foreground="{StaticResource TealBrush}" Margin="0,0,7,0" />
                    <TextBlock Style="{StaticResource Small}" Text="Takes a few seconds" />
                </StackPanel>
            </WrapPanel>

            <!-- Error -->
            <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                    Background="{StaticResource ProblemSoftBrush}" CornerRadius="10" Padding="16,12" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{StaticResource ProblemBrush}" VerticalAlignment="Top" Margin="0,3,12,0" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Body}" Text="{Binding Error}" />
                </Grid>
            </Border>

            <!-- Recent servers -->
            <StackPanel Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}" Margin="0,36,0,0">
                <TextBlock Style="{StaticResource SectionLabel}" Text="Recent servers" Margin="2,0,0,8" />
                <Border Style="{StaticResource Panel}">
                    <ItemsControl ItemsSource="{Binding Recent}" Focusable="False" Margin="5">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                                    <Button Command="{Binding ScanCommand}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="0,1">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Foreground="{StaticResource Muted2Brush}" Margin="0,0,14,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Style="{StaticResource Small}" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button Style="{StaticResource LinkButton}" FontSize="12.5" Command="{Binding UndoCommand}" Margin="0,0,20,0"
                                                        ToolTip="Put back files Map Doctor moved on this server"
                                                        Visibility="{Binding HasFixes, Converter={StaticResource BoolToVisibility}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" FontSize="11" Text="&#xE7A7;" Margin="0,1,6,0" />
                                                        <TextBlock Text="{Binding UndoLabel}" />
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock Style="{StaticResource Small}" Foreground="{StaticResource TealBrush}" FontWeight="SemiBold" Text="Scan" Margin="0,0,6,0" />
                                                <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE76C;" Foreground="{StaticResource TealBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                        <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <TextBlock Style="{StaticResource Small}" Foreground="{StaticResource Muted2Brush}" HorizontalAlignment="Center" Margin="0,40,0,0">
                <Run Text="Map Doctor" /> <Run Text="{Binding Version, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
