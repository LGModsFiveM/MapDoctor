<Window x:Class="LGMods.MapDoctor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LGMods.MapDoctor.App.ViewModels"
        xmlns:views="clr-namespace:LGMods.MapDoctor.App.Views"
        Title="LGMods Map Doctor"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1280" Height="840" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource BodyFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:WelcomeViewModel}">
            <views:WelcomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanningViewModel}">
            <views:ScanningView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultsViewModel}">
            <views:ResultsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResolveViewModel}">
            <views:ResolveView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PastFixesViewModel}">
            <views:PastFixesView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource QuietButton}" Padding="10,6" Command="{Binding NewScanCommand}" ToolTip="Back to the start"
                        VerticalAlignment="Center" Margin="-10,2,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/logo.png" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <!-- The display font sits high in its line, so nudge it down to line up with the logo and "Map Doctor". -->
                        <TextBlock Style="{StaticResource Display}" FontSize="25" LineHeight="25" Text="LGMODS" VerticalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock Text="Map Doctor" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TealBrush}"
                                   VerticalAlignment="Center" Margin="10,1,0,0" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0"
                            Visibility="{Binding HasServer, Converter={StaticResource BoolToVisibility}}">
                    <Rectangle Width="1" Height="18" Fill="{StaticResource LineStrongBrush}" Margin="0,0,18,0" />
                    <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE8B7;" Foreground="{StaticResource Muted2Brush}" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding ServerName}" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               ToolTip="{Binding ServerPath}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TopLink}" Command="{Binding NewScanCommand}"
                            Visibility="{Binding HasServer, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE710;" Margin="0,0,8,0" />
                            <TextBlock Text="Scan another server" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TopLink}" Command="{Binding OpenDiscordCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE8F2;" Margin="0,0,8,0" />
                            <TextBlock Text="Help on Discord" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TopLink}" Command="{Binding OpenStoreCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE719;" Margin="0,0,8,0" />
                            <TextBlock Text="LGMods store" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding Page}" Focusable="False" />

        <!-- Dialogs cover the whole window, top bar included. -->
        <ContentControl Grid.RowSpan="2" Content="{Binding Dialog}" Focusable="False" />
    </Grid>
</Window>
